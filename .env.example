# api database path (local dev: default ./api/daisy.db)
DAISY_DB_PATH=/data/daisy.db

# web -> api internal URL (docker compose build arg sets http://api:8000)
API_INTERNAL_URL=http://api:8000

# mcp server -> api URL
DAISY_API_URL=http://localhost:8000

# mcp http transport: optional bearer token (empty = no auth, localhost-only)
MCP_TOKEN=